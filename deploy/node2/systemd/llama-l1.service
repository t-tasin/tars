[Unit]
Description=T.A.R.S. llama-l1 (Qwen3-8B Q4_K_M brain tier, CPU-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tasin
Group=tasin
WorkingDirectory=/home/tasin
# Hide GPU from this process — M620 (2GB) is fully claimed by llama-embed.
# `-ngl 0` alone is insufficient: llama.cpp still tries to allocate the compute
# buffer on CUDA0 when the binary is CUDA-enabled. Empty CUDA_VISIBLE_DEVICES
# forces CPU-only path.
Environment="CUDA_VISIBLE_DEVICES="
ExecStart=/home/tasin/llama.cpp/build/bin/llama-server \
  -m /home/tasin/models/Qwen3-8B-Q4_K_M.gguf \
  --host 0.0.0.0 \
  --port 8002 \
  --ctx-size 4096 \
  --threads 6 \
  --n-gpu-layers 0 \
  --no-warmup \
  --alias qwen3-8b-brain
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

# CPU-only: 8B Q4_K_M (4.7GB) exceeds M620 2GB VRAM.
# Memory budget: 4.7GB model + ~1GB KV cache (4096 ctx) ≈ 6GB, fits 16GB RAM.

[Install]
WantedBy=multi-user.target
