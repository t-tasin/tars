# Node 1 (Brain) — Production Environment Variables
# Copy to .env.production and fill in values

DATABASE_URL=postgresql+asyncpg://tars:<password>@tars-db:5432/tars
POSTGRES_USER=tars
POSTGRES_PASSWORD=<password>
POSTGRES_DB=tars

REDIS_URL=redis://:<password>@10.0.1.2:6379/0
CHROMA_HOST=10.0.1.2
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=<token>

TARS_API_KEY=<key>
TARS_API_HOST=0.0.0.0
TARS_API_PORT=8000
TARS_SECRET_KEY=<secret>

GEMINI_API_KEY=<key>
TELEGRAM_BOT_TOKEN=<token>
TELEGRAM_CHAT_ID=<id>

GMAIL_CLIENT_ID=<id>
GMAIL_CLIENT_SECRET=<secret>
GMAIL_REFRESH_TOKEN=<token>
GMAIL_UNI_CLIENT_ID=<id>
GMAIL_UNI_CLIENT_SECRET=<secret>
GMAIL_UNI_REFRESH_TOKEN=<token>

CALDAV_URL=<url>
CALDAV_USERNAME=<username>
CALDAV_PASSWORD=<password>

GITHUB_PAT=<token>
NOTION_API_KEY=<key>
NOTION_DATABASE_ID=<id>

PLAID_CLIENT_ID=<id>
PLAID_SECRET=<secret>
PLAID_ACCESS_TOKEN=<token>
PLAID_ENV=production

WEATHER_API_KEY=<key>
WEATHER_LOCATION=<location>

PICOVOICE_ACCESS_KEY=<key>

APNS_KEY_ID=<id>
APNS_TEAM_ID=<id>
APNS_BUNDLE_ID=<bundle>
APNS_KEY_PATH=/run/secrets/apns_key.p8

CLOUDFLARE_TUNNEL_TOKEN=<token>

GRAFANA_URL=<url>
GRAFANA_API_KEY=<key>
LOKI_URL=<url>

BRAVE_API_KEY=<key>

APPRISE_TELEGRAM_URL=<url>
APPRISE_EMAIL_URL=<url>
