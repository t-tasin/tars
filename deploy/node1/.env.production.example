# T.A.R.S. Node 1 (Brain) — Production Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# --- Database ---
POSTGRES_PASSWORD=changeme

# --- TARS API ---
TARS_API_KEY=
ALLOWED_DEVICE_TOKENS=

# --- AI Models ---
GEMINI_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Gmail (base64-encoded OAuth JSON) ---
GMAIL_PERSONAL_CREDENTIALS=
GMAIL_PROFESSIONAL_CREDENTIALS=

# --- iCloud CalDAV ---
ICLOUD_CALDAV_USER=
ICLOUD_CALDAV_PASSWORD=

# --- GitHub ---
GITHUB_PAT=

# --- Notion ---
NOTION_TOKEN=

# --- Teller (Read-Only, HC-04) ---
TELLER_ACCESS_TOKEN=
TELLER_CERT_PATH=/etc/tars/teller/cert.pem
TELLER_KEY_PATH=/etc/tars/teller/key.pem
TELLER_ENV=sandbox

# --- Weather ---
OPENWEATHERMAP_API_KEY=

# --- Picovoice ---
PICOVOICE_ACCESS_KEY=

# --- APNs ---
APNS_KEY_ID=
APNS_TEAM_ID=

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Grafana / Loki ---
GRAFANA_URL=
GRAFANA_API_KEY=
LOKI_URL=

# --- SerpAPI ---
SERPAPI_KEY=

# --- Brave Search (MCP) ---
BRAVE_API_KEY=

# --- System ---
LOG_LEVEL=INFO
