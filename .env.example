# =============================================================================
# T.A.R.S. Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Database (PostgreSQL on Node 1) ---
DATABASE_URL=<placeholder>
POSTGRES_USER=<placeholder>
POSTGRES_PASSWORD=<placeholder>
POSTGRES_DB=<placeholder>

# --- Redis (Node 2) ---
REDIS_URL=<placeholder>
REDIS_PASSWORD=<placeholder>

# --- ChromaDB (Node 2) ---
CHROMA_HOST=<placeholder>
CHROMA_PORT=<placeholder>
CHROMA_AUTH_TOKEN=<placeholder>

# --- T.A.R.S. API ---
TARS_API_KEY=<placeholder>
TARS_API_HOST=<placeholder>
TARS_API_PORT=<placeholder>
TARS_SECRET_KEY=<placeholder>

# --- AI Models (Gemini) ---
GEMINI_API_KEY=<placeholder>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<placeholder>
TELEGRAM_CHAT_ID=<placeholder>

# --- Gmail (OAuth - Personal) ---
GMAIL_CLIENT_ID=<placeholder>
GMAIL_CLIENT_SECRET=<placeholder>
GMAIL_REFRESH_TOKEN=<placeholder>

# --- Gmail (OAuth - University) ---
GMAIL_UNI_CLIENT_ID=<placeholder>
GMAIL_UNI_CLIENT_SECRET=<placeholder>
GMAIL_UNI_REFRESH_TOKEN=<placeholder>

# --- iCloud CalDAV ---
CALDAV_URL=<placeholder>
CALDAV_USERNAME=<placeholder>
CALDAV_PASSWORD=<placeholder>

# --- GitHub ---
GITHUB_PAT=<placeholder>

# --- Notion ---
NOTION_API_KEY=<placeholder>
NOTION_DATABASE_ID=<placeholder>

# --- Plaid (Read-Only) ---
PLAID_CLIENT_ID=<placeholder>
PLAID_SECRET=<placeholder>
PLAID_ACCESS_TOKEN=<placeholder>
PLAID_ENV=<placeholder>

# --- Weather ---
WEATHER_API_KEY=<placeholder>
WEATHER_LOCATION=<placeholder>

# --- Picovoice (Wake Word) ---
PICOVOICE_ACCESS_KEY=<placeholder>

# --- APNs (Apple Push Notifications) ---
APNS_KEY_ID=<placeholder>
APNS_TEAM_ID=<placeholder>
APNS_BUNDLE_ID=<placeholder>
APNS_KEY_PATH=<placeholder>

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=<placeholder>

# --- Grafana / Loki ---
GRAFANA_URL=<placeholder>
GRAFANA_API_KEY=<placeholder>
LOKI_URL=<placeholder>

# --- Brave Search (MCP) ---
BRAVE_API_KEY=<placeholder>

# --- SerpAPI (Optional) ---
SERPAPI_KEY=<placeholder>

# --- Apprise (Notifications) ---
APPRISE_TELEGRAM_URL=<placeholder>
APPRISE_EMAIL_URL=<placeholder>
