# =============================================================================
# T.A.R.S. Environment Variables
# Copy to .env and fill in values before running docker compose up
# =============================================================================

# --- Database (PostgreSQL on Node 1) ---
POSTGRES_PASSWORD=<placeholder>
# DATABASE_URL is built by docker-compose; only set manually for local dev:
# DATABASE_URL=postgresql+asyncpg://tars:<password>@localhost:5432/tars

# --- Redis (Node 1 — accessed via Tailscale IP) ---
# Hardcoded in docker-compose; override only if Node 1 IP changes:
# REDIS_URL=redis://100.94.4.103:6379/0

# --- Qdrant (Vector DB on Node 2 — accessed via Tailscale IP) ---
QDRANT_URL=http://100.119.114.125:6333
# Optional API key (leave empty until auth is enabled in qdrant config):
# QDRANT_API_KEY=

# --- T.A.R.S. API ---
TARS_API_KEY=<placeholder>
# Comma-separated iOS device tokens for auth (optional, leave empty initially):
ALLOWED_DEVICE_TOKENS=

# --- AI Models (Gemini) ---
GEMINI_API_KEY=<placeholder>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<placeholder>
TELEGRAM_CHAT_ID=<placeholder>

# --- Gmail (base64-encoded OAuth JSON) ---
# Each value is a base64-encoded JSON object:
#   {"client_id": "...", "client_secret": "...", "refresh_token": "...", "token_uri": "https://oauth2.googleapis.com/token"}
# Encode: echo '{"client_id":"...","client_secret":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token"}' | base64
GMAIL_PERSONAL_CREDENTIALS=<placeholder>
GMAIL_PROFESSIONAL_CREDENTIALS=<placeholder>

# --- iCloud CalDAV ---
ICLOUD_CALDAV_USER=<placeholder>
ICLOUD_CALDAV_PASSWORD=<placeholder>

# --- GitHub ---
GITHUB_PAT=<placeholder>

# --- Notion ---
NOTION_TOKEN=<placeholder>
# Note: Notion database IDs are stored in the config DB, not env vars.
# Set them via: PUT /api/v1/config {namespace: "notion", key: "tasks_database_id", value: "..."}

# --- Teller (Read-Only, HC-04) ---
TELLER_ACCESS_TOKEN=<placeholder>
TELLER_CERT_PATH=/etc/tars/teller/cert.pem
TELLER_KEY_PATH=/etc/tars/teller/key.pem
TELLER_ENV=sandbox

# --- Weather ---
OPENWEATHERMAP_API_KEY=<placeholder>

# --- Picovoice (Wake Word) ---
PICOVOICE_ACCESS_KEY=<placeholder>

# --- APNs (Apple Push Notifications) ---
# Leave empty until you have an Apple Developer account
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=<placeholder>

# --- Grafana / Loki (optional) ---
GRAFANA_URL=
GRAFANA_API_KEY=
LOKI_URL=

# --- Brave Search (MCP) ---
BRAVE_API_KEY=<placeholder>

# --- SerpAPI (optional) ---
SERPAPI_KEY=

# --- Logging ---
LOG_LEVEL=INFO

# --- Public SSE Stream (P3-13, HC-13) ---
# Optional bearer token that gates GET /api/v1/public/stream. Empty = public.
PUBLIC_STREAM_TOKEN=
# CORS origin for the public dashboard. Empty = same-origin only.
PUBLIC_DASHBOARD_ORIGIN=
# HMAC secret for hashing identifiers in public events. MUST be set in prod.
PUBLIC_STREAM_HASH_SECRET=
